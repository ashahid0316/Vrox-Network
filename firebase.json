{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/whitepaper",
        "destination": "/whitepaper/index.html"
      },
      {
        "source": "/download",
        "destination": "/download/index.html"
      },
      {
        "source": "/knowledge-hub",
        "destination": "/knowledge-hub/index.html"
      },
      {
        "source": "/privacy-policy",
        "destination": "/privacy-policy/index.html"
      },
      {
        "source": "/support",
        "destination": "/support/index.html"
      },
      {
        "source": "/terms",
        "destination": "/terms/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Content-Security-Policy",
            "value": "upgrade-insecure-requests"
          }
        ]
      }
    ]
  }
}
